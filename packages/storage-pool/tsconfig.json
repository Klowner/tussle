		"resolveJsonModule": true,
		"outDir": "lib",
		"rootDir": "src",
		"target": "es2022",
		"lib": ["es2022"],
		"types": [
			"@cloudflare/workers-types/2022-11-30",
			"jest"
		]
	},
	"include": ["src/**/*"],
